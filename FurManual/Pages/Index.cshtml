@page
@model IndexModel
@{
    ViewData["Title"] = "Главная панель";
}

<style>
    .dashboard-container {
        max-width: 1200px;
        margin: 0 auto;
        padding-bottom: 3rem;
    }

    /* --- HERO СЕКЦИЯ --- */
    .hero-section {
        background: linear-gradient(135deg, var(--accent-primary, #667eea) 0%, var(--accent-secondary, #764ba2) 100%);
        border-radius: 16px;
        padding: 3rem 2.5rem;
        color: white;
        margin-bottom: 2.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        position: relative;
        overflow: hidden;
    }

        .hero-section::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 70%);
            border-radius: 50%;
            pointer-events: none;
        }

    .hero-content {
        position: relative;
        z-index: 1;
        max-width: 600px;
    }

    .hero-title {
        font-size: 2.2rem;
        font-weight: 700;
        margin: 0 0 1rem 0;
        line-height: 1.2;
    }

    .hero-desc {
        font-size: 1.1rem;
        opacity: 0.9;
        margin-bottom: 1.5rem;
        line-height: 1.5;
    }

    .hero-stats {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .stat-badge {
        background: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(5px);
        padding: 0.6rem 1.2rem;
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-weight: 500;
        font-size: 0.95rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .stat-icon {
        width: 20px;
        height: 20px;
        stroke: currentColor;
        stroke-width: 2;
        fill: none;
    }

    .hero-illustration {
        position: relative;
        z-index: 1;
        opacity: 0.9;
    }

        .hero-illustration svg {
            width: 180px;
            height: 180px;
        }

    /* --- КАРТОЧКИ ПРОГРЕССА --- */
    .progress-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
        margin-bottom: 3rem;
    }

    .progress-card {
        background: var(--bg-secondary, #ffffff);
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 16px;
        padding: 1.8rem;
        text-decoration: none;
        color: var(--text-primary);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 1.5rem;
    }

        .progress-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.06);
            color: var(--text-primary);
        }

    .progress-header {
        display: flex;
        align-items: center;
        gap: 1.2rem;
    }

    .progress-icon-wrapper {
        width: 54px;
        height: 54px;
        border-radius: 14px;
        background: rgba(102, 126, 234, 0.1);
        color: var(--accent-primary, #667eea);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .progress-icon-wrapper svg {
            width: 28px;
            height: 28px;
            stroke-width: 2;
            fill: none;
            stroke: currentColor;
        }

    .progress-title-block h3 {
        font-size: 1.2rem;
        font-weight: 700;
        margin: 0 0 0.3rem 0;
    }

    .progress-title-block p {
        font-size: 0.9rem;
        color: var(--text-secondary);
        margin: 0;
    }

    /* Внутренности карточки Тестов (Светофор) */
    .score-badges {
        display: flex;
        gap: 0.8rem;
        flex-wrap: wrap;
    }

    .score-badge {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.5rem 0.8rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
    }

        .score-badge .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }

    .score-green {
        background: #f0fdf4;
        color: #15803d;
        border: 1px solid #bbf7d0;
    }

        .score-green .dot {
            background: #22c55e;
        }

    .score-yellow {
        background: #fefce8;
        color: #a16207;
        border: 1px solid #fef08a;
    }

        .score-yellow .dot {
            background: #eab308;
        }

    .score-red {
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

        .score-red .dot {
            background: #ef4444;
        }

    /* Внутренности карточки Cisco (Прогресс бар) */
    .cisco-bar-wrapper {
        width: 100%;
    }

    .cisco-bar {
        height: 10px;
        background: #e2e8f0;
        border-radius: 5px;
        overflow: hidden;
        margin-bottom: 0.5rem;
    }

    .cisco-fill {
        height: 100%;
        background: var(--accent-primary, #667eea);
        border-radius: 5px;
        transition: width 1s ease-out;
    }

    .cisco-info {
        display: flex;
        justify-content: space-between;
        font-size: 0.85rem;
        color: var(--text-secondary);
        font-weight: 500;
    }

    /* --- ПОСЛЕДНИЕ МАТЕРИАЛЫ --- */
    .recent-sections-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: 2rem;
        align-items: start;
    }

    .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.2rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid rgba(0,0,0,0.03);
    }

    .section-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
    }

    .view-all-link {
        font-size: 0.9rem;
        color: var(--accent-primary, #667eea);
        text-decoration: none;
        font-weight: 600;
        transition: opacity 0.2s;
    }

        .view-all-link:hover {
            opacity: 0.8;
        }

    /* Карточки последних материалов */
    .recent-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .recent-item {
        background: var(--bg-secondary, #ffffff);
        border-radius: 12px;
        border: 1px solid rgba(0,0,0,0.03);
        padding: 1.2rem;
        display: flex;
        align-items: flex-start;
        gap: 1.2rem;
        text-decoration: none;
        color: var(--text-primary);
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .recent-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.05);
            color: var(--text-primary);
        }

    .recent-icon-img {
        width: 48px;
        height: 48px;
        object-fit: contain;
        flex-shrink: 0;
        margin-top: 0.2rem;
    }

    .recent-content {
        flex-grow: 1;
        min-width: 0;
    }

    .recent-title {
        font-size: 1.1rem;
        font-weight: 600;
        margin: 0 0 0.5rem 0;
        line-height: 1.4;
        white-space: normal;
        word-wrap: break-word;
        word-break: break-word;
    }

    .recent-date {
        font-size: 0.85rem;
        color: var(--text-secondary);
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

        .recent-date svg {
            width: 16px;
            height: 16px;
            stroke: currentColor;
            stroke-width: 2;
            fill: none;
        }

    /* Пустое состояние */
    .recent-empty {
        text-align: center;
        padding: 2rem 1rem;
        color: var(--text-secondary);
        background: var(--bg-secondary, #ffffff);
        border-radius: 12px;
        border: 1px dashed rgba(0,0,0,0.1);
        font-weight: 500;
    }

    /* АДАПТИВНОСТЬ */
    @@media (max-width: 992px) {
        .hero-section {
            flex-direction: column;
            text-align: center;
            padding: 2.5rem 1.5rem;
            gap: 2rem;
        }

        .hero-stats {
            justify-content: center;
        }

        .hero-illustration {
            display: none;
        }
    }

    @@media (max-width: 768px) {
        .recent-sections-grid {
            grid-template-columns: 1fr;
        }

        .hero-title {
            font-size: 1.8rem;
        }
    }
</style>

<div class="dashboard-container">

    <!-- HERO СЕКЦИЯ -->
    <div class="hero-section">
        <div class="hero-content">
            <h1 class="hero-title">
                Добро пожаловать@(string.IsNullOrEmpty(Model.StudentName) ? "!" : $", {Model.StudentName}!")
            </h1>
            <p class="hero-desc">
                Это ваша личная образовательная панель. Изучайте теорию, выполняйте практические работы и проверяйте свои знания.
            </p>

            <div class="hero-stats">
                <div class="stat-badge" title="Сдано тестов">
                    <svg class="stat-icon" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    <span>Выполнено тестов: <strong>@Model.CompletedTestsCount</strong></span>
                </div>
                <div class="stat-badge" title="Завершено заданий Cisco">
                    <svg class="stat-icon" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                    <span>Завершено Cisco: <strong>@Model.CompletedCiscoTasksCount</strong></span>
                </div>
            </div>
        </div>

        <div class="hero-illustration">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"></path>
            </svg>
        </div>
    </div>

    <!-- КАРТОЧКИ ДЕТАЛЬНОГО ПРОГРЕССА -->
    <div class="progress-grid">
        <a asp-page="/Tests/Index" class="progress-card">
            <div class="progress-header">
                <div class="progress-icon-wrapper">
                    <svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                </div>
                <div class="progress-title-block">
                    <h3>Успеваемость по тестам</h3>
                    <p>Пройдено @Model.CompletedTestsCount из @Model.TotalTestsCount тестов</p>
                </div>
            </div>

            <div class="score-badges">
                <div class="score-badge score-green" title="Отлично (80-100%)">
                    <span class="dot"></span> @Model.GreenTestsCount
                </div>
                <div class="score-badge score-yellow" title="Хорошо (50-79%)">
                    <span class="dot"></span> @Model.YellowTestsCount
                </div>
                <div class="score-badge score-red" title="Нужно повторить (<50%)">
                    <span class="dot"></span> @Model.RedTestsCount
                </div>
            </div>
        </a>

        <!-- Прогресс Cisco -->
        <a asp-page="/Cisco" class="progress-card">
            <div class="progress-header">
                <div class="progress-icon-wrapper">
                    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                </div>
                <div class="progress-title-block">
                    <h3>Конструктор Cisco</h3>
                    <p>Практические задания сети</p>
                </div>
            </div>

            @{
                var ciscoPercent = Model.TotalCiscoTasksCount > 0
                ? (int)Math.Round((double)Model.CompletedCiscoTasksCount / Model.TotalCiscoTasksCount * 100)
                : 0;
            }

            <div class="cisco-bar-wrapper">
                <div class="cisco-bar">
                    <div class="cisco-fill" style="width: @(ciscoPercent)%;"></div>
                </div>
                <div class="cisco-info">
                    <span>@Model.CompletedCiscoTasksCount из @Model.TotalCiscoTasksCount заданий</span>
                    <span>@ciscoPercent%</span>
                </div>
            </div>
        </a>
    </div>

    <!-- ПОСЛЕДНИЕ ДОБАВЛЕНИЯ -->
    <div class="recent-sections-grid">

        <div class="recent-column">
            <div class="section-header">
                <h3 class="section-title">Свежие лекции</h3>
                <a asp-page="/Lectures" class="view-all-link">Все лекции →</a>
            </div>

            <div class="recent-list">
                @if (Model.RecentLectures != null && Model.RecentLectures.Any())
                {
                    @foreach (var lecture in Model.RecentLectures)
                    {
                        var ext = System.IO.Path.GetExtension(lecture.FilePath ?? "").ToLower();
                        var icon = (ext == ".doc" || ext == ".docx") ? "/Res/SVG/Word.svg" : "/Res/SVG/Pdf.svg";

                        <a asp-page="/Lectures" class="recent-item" title="Перейти к лекциям">
                            <img src="@icon" alt="@ext" class="recent-icon-img" onerror="this.style.display='none'" />
                            <div class="recent-content">
                                <h4 class="recent-title">@lecture.Title</h4>
                                <div class="recent-date">
                                    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                    @lecture.CreatedAt.ToString("dd.MM.yyyy")
                                </div>
                            </div>
                        </a>
                    }
                }
                else
                {
                    <div class="recent-empty">Лекции пока не добавлены</div>
                }
            </div>
        </div>

        <!-- Колонка: Новая практика -->
        <div class="recent-column">
            <div class="section-header">
                <h3 class="section-title">Новая практика</h3>
                <a asp-page="/PracticalWorks" class="view-all-link">Вся практика →</a>
            </div>

            <div class="recent-list">
                @if (Model.RecentPracticals != null && Model.RecentPracticals.Any())
                {
                    @foreach (var work in Model.RecentPracticals)
                    {
                        var ext = System.IO.Path.GetExtension(work.FilePath ?? "").ToLower();
                        var icon = (ext == ".doc" || ext == ".docx") ? "/Res/SVG/Word.svg" : "/Res/SVG/Pdf.svg";

                        <a asp-page="/PracticalWorks" class="recent-item" title="Перейти к практическим">
                            <img src="@icon" alt="@ext" class="recent-icon-img" onerror="this.style.display='none'" />
                            <div class="recent-content">
                                <h4 class="recent-title">@work.Title</h4>
                                <div class="recent-date">
                                    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                    @work.CreatedAt.ToString("dd.MM.yyyy")
                                </div>
                            </div>
                        </a>
                    }
                }
                else
                {
                    <div class="recent-empty">Практика пока не добавлена</div>
                }
            </div>
        </div>

    </div>
</div>