@page
@model FurManual.Pages.PracticalWorksModel
@using System.IO
@{
    ViewData["Title"] = "Практические работы";
    var hasErrors = !ModelState.IsValid;
}

<style>
    .practical-works-page {
        max-width: 1200px;
        margin: 0 auto;
        padding-bottom: 3rem;
    }

    .page-header {
        margin-bottom: 1.5rem;
    }

    .page-title {
        font-size: 2rem;
        font-weight: 700;
        margin: 0 0 1rem 0;
        color: var(--text-primary);
        line-height: 1.2;
        word-wrap: break-word;
        word-break: break-word;
        overflow-wrap: break-word;
        hyphens: auto;
    }

    .controls-panel {
        background: var(--bg-secondary);
        padding: 1.5rem;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
        border: 1px solid rgba(0,0,0,0.05);
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    /* --- ПОИСК --- */
    .search-wrapper {
        width: 100%;
    }

    .search-form {
        display: flex;
        width: 100%;
        gap: 0.5rem;
        align-items: center;
    }

    .input-group {
        position: relative;
        flex-grow: 1;
        display: flex;
        align-items: center;
    }

    .search-input {
        width: 100%;
        padding: 0.8rem 2.5rem 0.8rem 1.2rem;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background: var(--bg-primary);
        color: var(--text-primary);
        outline: none;
        font-size: 1rem;
        transition: border-color 0.2s;
    }

        .search-input:focus {
            border-color: var(--accent-primary);
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

    .btn-clear-search {
        position: absolute;
        right: 10px;
        background: transparent;
        border: none;
        cursor: pointer;
        color: var(--text-secondary);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4px;
        border-radius: 50%;
        transition: all 0.2s;
        opacity: 0;
        pointer-events: none;
    }

        .btn-clear-search.active {
            opacity: 1;
            pointer-events: all;
        }

        .btn-clear-search:hover {
            background: rgba(0,0,0,0.05);
            color: #e74c3c;
        }

    .filters-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .sort-group {
        display: flex;
        background: var(--bg-primary);
        border-radius: 8px;
        padding: 0.3rem;
        border: 1px solid rgba(0,0,0,0.05);
    }

    .sort-btn {
        padding: 0.5rem 1rem;
        border: none;
        background: transparent;
        cursor: pointer;
        color: var(--text-secondary);
        font-size: 0.9rem;
        transition: all 0.2s;
        font-weight: 500;
        border-radius: 6px;
    }

        .sort-btn.active {
            background: white;
            color: var(--accent-primary);
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            font-weight: 600;
        }

    .admin-disclosure {
        margin-bottom: 2rem;
        background: var(--bg-secondary);
        border-radius: 16px;
        border: 1px solid rgba(102, 126, 234, 0.3);
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    }

    .admin-summary {
        padding: 1.2rem 1.5rem;
        cursor: pointer;
        font-weight: 600;
        color: var(--accent-primary);
        list-style: none;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        transition: background 0.2s;
    }

        .admin-summary:hover {
            background: var(--sidebar-hover);
        }

        .admin-summary::-webkit-details-marker {
            display: none;
        }

    .ui-icon {
        width: 20px;
        height: 20px;
        stroke-width: 2;
        display: block;
    }

    .admin-panel {
        padding: 1.5rem 2rem 2rem 2rem;
        border-top: 1px solid rgba(0,0,0,0.05);
        background: #fafbff;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        margin-bottom: 1.5rem;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .form-group input[type="text"] {
        width: 100%;
        padding: 0.8rem 1rem;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        font-size: 1rem;
    }

    input[type="file"]::file-selector-button {
        border: 1px solid #d1d5db;
        background: #f3f4f6;
        color: #374151;
        padding: 0.6rem 1.2rem;
        border-radius: 8px;
        cursor: pointer;
        margin-right: 1rem;
        transition: all 0.2s;
        font-family: inherit;
        font-weight: 500;
    }

        input[type="file"]::file-selector-button:hover {
            background: #e5e7eb;
            border-color: #9ca3af;
        }

    input[type="file"] {
        padding: 0.4rem;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        width: 100%;
        color: var(--text-primary);
    }

    .form-actions {
        display: flex;
        gap: 1rem;
        margin-top: 1rem;
    }

        .form-actions .btn-submit {
            flex: 1;
        }

    .btn-submit {
        width: 100%;
        padding: 1rem;
        background: linear-gradient(135deg, var(--accent-primary) 0%, var(--accent-secondary) 100%);
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: transform 0.1s, opacity 0.2s;
    }

        .btn-submit:hover {
            opacity: 0.95;
        }

        .btn-submit:active {
            transform: scale(0.99);
        }

    .btn-cancel {
        padding: 1rem 2rem;
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .btn-cancel:hover {
            background: #e2e8f0;
            color: #1e293b;
            border-color: #94a3b8;
        }

    .text-danger {
        color: #e74c3c;
        font-size: 0.85rem;
        margin-top: 0.4rem;
        display: block;
        font-weight: 500;
    }

    .form-hint {
        display: block;
        font-size: 0.8rem;
        color: var(--text-secondary);
        margin-top: 0.4rem;
    }

    .practical-works-grid {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        position: relative;
        min-height: 200px;
    }

        .practical-works-grid.loading {
            opacity: 0.6;
            pointer-events: none;
        }

    .practical-work-card {
        background: var(--bg-secondary);
        border-radius: 12px;
        transition: all 0.3s ease;
        border: 1px solid rgba(0,0,0,0.03);
        display: flex;
        align-items: flex-start;
        padding: 1.2rem;
        gap: 1.5rem;
    }

        .practical-work-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.05);
        }

    .file-icon-img {
        width: 48px;
        height: 48px;
        object-fit: contain;
        flex-shrink: 0;
        margin-top: 0.2rem;
    }

    .practical-work-content {
        flex-grow: 1;
        min-width: 0;
    }

    .practical-work-title {
        margin: 0 0 0.8rem 0;
        font-size: 1.1rem;
        color: var(--text-primary);
        font-weight: 600;
        line-height: 1.4;
        white-space: normal;
        word-wrap: break-word;
        word-break: break-word;
    }

    .practical-work-meta {
        font-size: 0.85rem;
        color: var(--text-secondary);
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .meta-icon {
        width: 16px;
        height: 16px;
        stroke: var(--text-secondary);
        stroke-width: 2;
        fill: none;
    }

    .meta-updated {
        color: #0284c7;
    }

        .meta-updated .meta-icon {
            stroke: #0284c7;
        }

    .meta-details {
        margin-top: 0.2rem;
    }

    .meta-summary {
        cursor: pointer;
        user-select: none;
        list-style: none;
        transition: color 0.2s;
    }

        .meta-summary::-webkit-details-marker {
            display: none;
        }

        .meta-summary:hover {
            color: var(--text-primary);
        }

    .meta-chevron {
        width: 14px;
        height: 14px;
        stroke-width: 2;
        transition: transform 0.3s ease;
        margin-left: 0.2rem;
    }

    .meta-details[open] .meta-chevron {
        transform: rotate(180deg);
    }

    .meta-details-content {
        margin-top: 0.5rem;
        padding-left: 1.8rem;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        border-left: 2px solid rgba(0,0,0,0.05);
        margin-left: 0.4rem;
    }

    .card-actions {
        display: flex;
        gap: 0.75rem;
        flex-shrink: 0;
        margin-top: 0.2rem;
    }

    .action-btn {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        transition: 0.2s;
        border: none;
        cursor: pointer;
    }

    .preview {
        background: #e0f2fe;
        color: #0284c7;
    }

        .preview:hover {
            background: #bae6fd;
        }

    .download {
        background: #f0f3f7;
        color: #4b6584;
    }

        .download:hover {
            background: #d1d8e0;
        }

    .edit {
        background: #fffbeb;
        color: #d97706;
    }

        .edit:hover {
            background: #fde68a;
            color: #b45309;
        }

    .delete {
        background: #fff5f5;
        color: #eb4d4b;
    }

        .delete:hover {
            background: #fab1a0;
            color: white;
        }

    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 2rem;
        text-align: center;
        color: var(--text-secondary);
        opacity: 0.8;
    }

    .empty-state-img {
        width: 120px;
        height: 120px;
        margin-bottom: 1.5rem;
        opacity: 0.6;
        filter: grayscale(100%);
    }

    .empty-state p {
        font-size: 1.2rem;
        font-weight: 500;
        margin: 0;
    }

    .pagination {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 3rem;
    }

    .page-btn {
        min-width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: var(--bg-secondary);
        color: var(--text-primary);
        text-decoration: none;
        border: 1px solid rgba(0,0,0,0.1);
        transition: all 0.2s;
        font-size: 0.9rem;
        font-weight: 500;
    }

        .page-btn:hover {
            border-color: var(--accent-primary);
            color: var(--accent-primary);
        }

        .page-btn.active {
            background: var(--accent-primary);
            color: white;
            border-color: var(--accent-primary);
        }

        .page-btn.disabled {
            opacity: 0.5;
            pointer-events: none;
        }

    .copy-link {
        background: #e0e7ff;
        color: #4f46e5;
    }

        .copy-link:hover {
            background: #c7d2fe;
        }

    .fade-in {
        animation: fadeIn 0.2s ease-in-out;
    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: scale(0.8);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }

    }

    @@media (max-width: 768px) {
        .form-grid

    {
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    .form-actions {
        flex-direction: column;
        gap: 0.8rem;
    }

    .btn-cancel {
        width: 100%;
    }

    .practical-work-card {
        flex-direction: column;
        text-align: center;
        padding: 1.5rem;
        align-items: center;
    }

    .practical-work-meta {
        align-items: center;
    }

    .card-actions {
        width: 100%;
        justify-content: center;
        margin-top: 1rem;
    }

    .controls-panel {
        padding: 1rem;
        gap: 1rem;
    }

    .filters-row {
        flex-direction: column;
        align-items: stretch;
    }

    .sort-group {
        justify-content: center;
    }

    .page-title {
        font-size: 1.6rem;
    }

    input[type="file"]::file-selector-button {
        width: 100%;
        margin-right: 0;
        margin-bottom: 0.5rem;
        display: block;
    }

    input[type="file"] {
        padding: 0.8rem;
        height: auto;
    }
    

    .search-input {
        padding-left: 0.8rem;
    }

    }
</style>

<div class="practical-works-page">

    <div class="page-header">
        <h2 class="page-title">Практические работы</h2>
    </div>

    <div class="controls-panel"
         id="practicalWorksControls"
         data-initial-search-term="@Model.SearchTerm"
         data-initial-sort-order="@Model.SortOrder"
         style="min-height: 110px;"></div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        @if (User.Identity?.IsAuthenticated == true)
        {
            <details class="admin-disclosure" id="practicalWorkFormDetails" @(hasErrors ? "open" : "")>
                <summary class="admin-summary">
                    <svg class="ui-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    <span id="formTitleText">Добавить новую практическую работу</span>
                </summary>
                <div class="admin-panel">
                    <form method="post" enctype="multipart/form-data" class="upload-form" id="practicalWorkForm">
                        <input type="hidden" name="SortOrder" value="@Model.SortOrder" />
                        <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                        <input type="hidden" asp-for="PracticalWorkId" id="hiddenPracticalWorkId" value="" />

                        <div class="form-grid">
                            <div class="form-group">
                                <label asp-for="NewPracticalWorkTitle">Заголовок</label>
                                <input type="text" asp-for="NewPracticalWorkTitle" id="practicalWorkTitleInput" placeholder="Введите название..." required maxlength="100" />
                                <span asp-validation-for="NewPracticalWorkTitle" class="text-danger"></span>
                                <small class="form-hint">Максимум 100 символов.</small>
                            </div>
                            <div class="form-group">
                                <label>Выберите файл <span id="fileRequiredStar" style="color:red;">*</span></label>
                                <input type="file" asp-for="UploadedFile" id="practicalWorkFileInput" accept=".pdf,.doc,.docx" required />
                                <span asp-validation-for="UploadedFile" class="text-danger"></span>
                                <small class="form-hint" id="fileHintText">Поддерживаются: PDF, Word. Макс. размер: 50 МБ.</small>
                            </div>
                        </div>
                        <div class="form-actions">
                            <button type="submit" class="btn-submit" id="submitBtnText">Загрузить в базу</button>
                            <button type="button" class="btn-cancel" id="cancelEditBtn" style="display: none;">Отмена</button>
                        </div>
                        <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-top: 1rem;"></div>
                    </form>
                </div>
            </details>
        }
    }

    <div id="practicalWorksContainer">
        <partial name="_PracticalWorksGrid" model="Model" />
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/dist/practical-works-controller.js" asp-append-version="true"></script>
}